  "data_dictionary": [
    {
      "column": "trans_date_trans_time",
      "type": "datetime",
      "used": "derived (hour, day_of_week, is_weekend, age)",
      "description": "Timestamp of the transaction"
    },
    {
      "column": "cc_num",
      "type": "int",
      "used": "dropped",
      "reason": "Card identifier \u2014 PII, and leaks card-level patterns",
      "description": "Credit card number"
    },
    {
      "column": "merchant",
      "type": "string",
      "used": "dropped",
      "reason": "Very high cardinality (~700); category captures the signal",
      "description": "Merchant name"
    },
    {
      "column": "category",
      "type": "string",
      "used": "one-hot",
      "description": "14 transaction categories (e.g., grocery_pos, travel)"
    },
    {
      "column": "amt",
      "type": "float",
      "used": "log(amt)",
      "description": "Transaction amount in USD"
    },
    {
      "column": "first",
      "type": "string",
      "used": "dropped",
      "reason": "PII \u2014 cardholder first name",
      "description": "Cardholder first name"
    },
    {
      "column": "last",
      "type": "string",
      "used": "dropped",
      "reason": "PII \u2014 cardholder last name",
      "description": "Cardholder last name"
    },
    {
      "column": "gender",
      "type": "string",
      "used": "binary (M=1)",
      "description": "Cardholder gender (M/F)"
    },
    {
      "column": "street",
      "type": "string",
      "used": "dropped",
      "reason": "PII \u2014 street address",
      "description": "Cardholder street address"
    },
    {
      "column": "city",
      "type": "string",
      "used": "dropped",
      "reason": "High cardinality (~900); spatial signal captured by haversine",
      "description": "Cardholder city"
    },
    {
      "column": "state",
      "type": "string",
      "used": "dropped",
      "reason": "Collinear with lat/long",
      "description": "Cardholder state"
    },
    {
      "column": "zip",
      "type": "int",
      "used": "dropped",
      "reason": "PII-adjacent, redundant with lat/long",
      "description": "Cardholder ZIP code"
    },
    {
      "column": "lat",
      "type": "float",
      "used": "haversine",
      "description": "Cardholder latitude"
    },
    {
      "column": "long",
      "type": "float",
      "used": "haversine",
      "description": "Cardholder longitude"
    },
    {
      "column": "city_pop",
      "type": "int",
      "used": "log(city_pop)",
      "description": "Population of cardholder city"
    },
    {
      "column": "job",
      "type": "string",
      "used": "dropped",
      "reason": "~490 unique jobs \u2014 high cardinality and occupation is sensitive",
      "description": "Cardholder occupation"
    },
    {
      "column": "dob",
      "type": "date",
      "used": "age_at_txn (then dropped)",
      "description": "Cardholder date of birth"
    },
    {
      "column": "trans_num",
      "type": "string",
      "used": "dropped",
      "reason": "Transaction identifier \u2014 PII",
      "description": "Unique transaction ID"
    },
    {
      "column": "unix_time",
      "type": "int",
      "used": "dropped",
      "reason": "Redundant with trans_date_trans_time",
      "description": "UNIX timestamp of transaction"
    },
    {
      "column": "merch_lat",
      "type": "float",
      "used": "haversine",
      "description": "Merchant latitude"
    },
    {
      "column": "merch_long",
      "type": "float",
      "used": "haversine",
      "description": "Merchant longitude"
    },
    {
      "column": "is_fraud",
      "type": "int",
      "used": "TARGET",
      "description": "Label: 1 = fraudulent transaction, 0 = legitimate"
    }
  ]
}