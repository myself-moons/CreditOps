# CreditOps v2 Environment Configuration Example
# Copy to .env and replace placeholder values

# LogStore backend selection: 'sqlite' (default) or 'firebase'
STORE_BACKEND=sqlite

# Firebase Realtime Database configuration (optional; falls back to SQLite if unset or unavailable)
FIREBASE_CREDENTIALS_PATH=secrets/firebase_credentials.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Observatory API Keys mapped to roles (JSON string or comma-separated pairs key:role)
# Roles: risk_owner, ml_engineer
OBS_API_KEYS={"risk_owner_key_123":"risk_owner","ml_engineer_key_456":"ml_engineer"}
